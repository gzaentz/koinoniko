# Local secrets/config for Leadpoet Social Brain.
# Copy to .env for local use. Do not commit real secrets.

# X read API for sync-x-user and sync-x-metrics.
X_BEARER_TOKEN=""

# OpenRouter-backed draft generation.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_REASONING_MAX_TOKENS="1024"
SOCIAL_BRAIN_PROVIDER="leadpoet_social_brain.openrouter_provider:create_provider"

# Optional hosted task trigger token for cron/webhook calls to /api/tasks/*.
SOCIAL_BRAIN_TASK_TOKEN=""

# Optional OpenRouter tuning.
OPENROUTER_TEMPERATURE="0.8"
OPENROUTER_MAX_TOKENS="4000"
OPENROUTER_SITE_URL=""
OPENROUTER_APP_NAME="Leadpoet Social Brain"

# SQLite path. Railway can use /app/data/social_brain.sqlite3 with a mounted volume.
SOCIAL_BRAIN_DB="data/social_brain.sqlite3"
